{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/s977043/plangate/schemas/intent-context-package.schema.json",
  "title": "Intent Context Package v1",
  "description": "Immutable pre-Plan provenance snapshot for #1389. Final Plan/AC/approval remain downstream-owned.",
  "type": "object",
  "required": [
    "schema_version",
    "context_id",
    "task_id",
    "created_at",
    "resolver_version",
    "intent",
    "sources",
    "constraints",
    "acceptance_inputs",
    "assumptions",
    "unknowns",
    "conflicts"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "context_id": {
      "type": "string",
      "pattern": "^CTX-[0-9A-Za-z._-]+$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[0-9A-Za-z-]+$"
    },
    "supersedes_context_ref": { "$ref": "#/$defs/hashRefOrNull" },
    "created_at": { "type": "string", "format": "date-time" },
    "resolver_version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "intent": {
      "type": "object",
      "required": ["summary", "desired_outcomes", "non_goals"],
      "additionalProperties": false,
      "properties": {
        "summary": { "$ref": "#/$defs/summaryStatement" },
        "desired_outcomes": {
          "type": "array",
          "items": { "$ref": "#/$defs/outcomeStatement" }
        },
        "non_goals": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonGoalStatement" }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "constraints": {
      "type": "array",
      "items": { "$ref": "#/$defs/constraintStatement" }
    },
    "acceptance_inputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/acceptanceInputStatement" }
    },
    "assumptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/assumption" }
    },
    "unknowns": {
      "type": "array",
      "items": { "$ref": "#/$defs/unknown" }
    },
    "conflicts": {
      "type": "array",
      "items": { "$ref": "#/$defs/conflict" }
    }
  },
  "$defs": {
    "hashRefOrNull": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SRC-[0-9A-Za-z._-]+$"
      }
    },
    "summaryStatement": {
      "type": "object",
      "required": ["statement_id", "text", "source_ids"],
      "additionalProperties": false,
      "properties": {
        "statement_id": { "type": "string", "pattern": "^INT-[0-9A-Za-z._-]+$" },
        "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "source_ids": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "outcomeStatement": {
      "type": "object",
      "required": ["outcome_id", "text", "source_ids"],
      "additionalProperties": false,
      "properties": {
        "outcome_id": { "type": "string", "pattern": "^OUT-[0-9A-Za-z._-]+$" },
        "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "source_ids": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "nonGoalStatement": {
      "type": "object",
      "required": ["non_goal_id", "text", "source_ids"],
      "additionalProperties": false,
      "properties": {
        "non_goal_id": { "type": "string", "pattern": "^NG-[0-9A-Za-z._-]+$" },
        "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "source_ids": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "constraintStatement": {
      "type": "object",
      "required": ["constraint_id", "category", "statement", "source_ids"],
      "additionalProperties": false,
      "properties": {
        "constraint_id": { "type": "string", "pattern": "^CON-[0-9A-Za-z._-]+$" },
        "category": {
          "type": "string",
          "enum": ["functional", "technical", "security", "policy", "compatibility", "scope"]
        },
        "statement": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "source_ids": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "acceptanceInputStatement": {
      "type": "object",
      "required": ["input_id", "statement", "source_ids"],
      "additionalProperties": false,
      "properties": {
        "input_id": { "type": "string", "pattern": "^ACI-[0-9A-Za-z._-]+$" },
        "statement": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "source_ids": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "assumption": {
      "type": "object",
      "required": ["assumption_id", "statement", "source_ids", "verification_needed"],
      "additionalProperties": false,
      "properties": {
        "assumption_id": { "type": "string", "pattern": "^ASM-[0-9A-Za-z._-]+$" },
        "statement": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^SRC-[0-9A-Za-z._-]+$" }
        },
        "verification_needed": { "type": "boolean", "const": true }
      }
    },
    "unknown": {
      "type": "object",
      "required": ["unknown_id", "question", "blocking"],
      "additionalProperties": false,
      "properties": {
        "unknown_id": { "type": "string", "pattern": "^UNK-[0-9A-Za-z._-]+$" },
        "question": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "blocking": { "type": "boolean" }
      }
    },
    "conflict": {
      "type": "object",
      "required": ["conflict_id", "statement_refs", "source_ids", "description"],
      "additionalProperties": false,
      "properties": {
        "conflict_id": { "type": "string", "pattern": "^CFT-[0-9A-Za-z._-]+$" },
        "statement_refs": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "source_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^SRC-[0-9A-Za-z._-]+$" }
        },
        "description": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "source_id",
        "kind",
        "ref",
        "authority",
        "authority_basis",
        "freshness",
        "freshness_basis",
        "observed_at"
      ],
      "additionalProperties": false,
      "properties": {
        "source_id": { "type": "string", "pattern": "^SRC-[0-9A-Za-z._-]+$" },
        "kind": {
          "type": "string",
          "enum": ["pbi_input", "issue", "spec", "adr", "code", "discussion", "prior_run"]
        },
        "ref": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "revision_ref": { "type": ["string", "null"], "maxLength": 512 },
        "content_digest": { "$ref": "#/$defs/hashRefOrNull" },
        "authority": {
          "type": "string",
          "enum": ["authoritative", "supporting", "unverified"]
        },
        "authority_basis": {
          "type": "object",
          "required": ["kind", "ref"],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "explicit_human_designation",
                "repository_canon",
                "artifact_contract",
                "unverified_default"
              ]
            },
            "ref": { "type": ["string", "null"], "maxLength": 1024 }
          }
        },
        "freshness": {
          "type": "string",
          "enum": ["current", "stale", "unknown"]
        },
        "freshness_basis": {
          "type": "object",
          "required": ["kind", "ref"],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "bound_revision",
                "fetched_latest",
                "explicit_human_assertion",
                "unavailable"
              ]
            },
            "ref": { "type": ["string", "null"], "maxLength": 1024 }
          }
        },
        "observed_at": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "authority": { "const": "authoritative" } },
            "required": ["authority"]
          },
          "then": {
            "properties": {
              "authority_basis": {
                "properties": {
                  "kind": {
                    "enum": [
                      "explicit_human_designation",
                      "repository_canon",
                      "artifact_contract"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "freshness": { "const": "current" } },
            "required": ["freshness"]
          },
          "then": {
            "allOf": [
              {
                "anyOf": [
                  {
                    "required": ["revision_ref"],
                    "properties": {
                      "revision_ref": { "type": "string", "minLength": 1 }
                    }
                  },
                  {
                    "required": ["content_digest"],
                    "properties": {
                      "content_digest": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                      }
                    }
                  }
                ]
              },
              {
                "properties": {
                  "freshness_basis": {
                    "properties": {
                      "kind": {
                        "enum": [
                          "bound_revision",
                          "fetched_latest",
                          "explicit_human_assertion"
                        ]
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    }
  }
}
