 set -eu
+set -f  # コマンド文字列のトークン走査で glob 展開させない
+
+# --- stdin を 1 回だけ読む（TTY 直叩き時はハングさせない） ---
+_stdin=""
+if [ ! -t 0 ]; then
+  _stdin=$(cat 2>/dev/null || true)
+fi
 
-# PLANGATE_SKIP_TOKEN_GUARD=1 で全スキップ（緊急/テスト用）
+_json_get() {
+  # $1: jq path / $2: jq 不在時の grep フォールバック用キー名
+  # jq が無い環境で **guard が fail-open しない**ようフォールバックを持つ
+  # （EH-9 check-delegation-commit-boundary.sh と同方式）。
+  _v=""
+  if [ -n "$_stdin" ] && command -v jq >/dev/null 2>&1; then
+    _v=$(printf '%s' "$_stdin" | jq -r "$1 // empty" 2>/dev/null || true)
+  fi
+  if [ -z "$_v" ] && [ -n "$_stdin" ] && [ -n "${2:-}" ]; then
+    _v=$(printf '%s' "$_stdin" \
+      | grep -o "\"$2\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" \
+      | head -1 | sed 's/.*"\([^"]*\)"$/\1/')
+  fi
+  printf '%s' "$_v"
+}
+
+_block() {
+  printf '[EH-token-guard] BLOCK: %s\n' "$2" >&2
+  printf '  検出: %s\n' "$1" >&2
+  printf '  正規操作: bin/plangate approve <TASK>（Human TTY / TASK-0128）または bin/plangate maintenance start\n' >&2
+  printf '  C-4（PR 承認 / merge）は Human-owned です（.claude/rules/responsibility-classes.md）。\n' >&2
+  exit 2
+}
+
+# ===========================================================================
+# (b) AI 自己承認ガード（#928 AC-5 / AC-6）— env で緩和しない
+# ===========================================================================
+
+# 承認相当の REST/GraphQL 直叩きパターン
+_is_api_approve() {
+  printf '%s' "$1" | grep -qiE 'addpullrequestreview' && return 0
+  printf '%s' "$1" | grep -qiE '(^|[^a-z])api([^a-z]|$)|graphql|/pulls/[^ ]*/reviews' || return 1
+  printf '%s' "$1" | grep -qiE 'event[=:][[:space:]]*"?approve' && return 0
+  return 1
+}
+
+# 1 セグメント（; | & () で分割済み・引用符除去済み）を検査
+# 戻り: 0=違反, 1=問題なし
+_seg_is_self_approve() {
+  _seg=$1
+  _st=0        # 0: 'pr' 未検出 / 1: 'pr' 検出 / 2: 'pr review' 検出
+  _apr=0       # --approve / -a
+  _other=0     # --comment / --request-changes（明示的な非承認 verdict）
+  _skip=0      # 直前が値を取るフラグ
+  for _t in $_seg; do
+    if [ "$_skip" = "1" ]; then _skip=0; continue; fi
+    case "$_t" in
+      -h|--help) return 1 ;;                       # help は常に許可
+      -b|--body|-F|--body-file|-R|--repo) _skip=1; continue ;;
+      --approve|--approve=*) _apr=1; continue ;;
+      --comment|--comment=*|--request-changes|--request-changes=*) _other=1; continue ;;
+      --*) continue ;;
+      -*)
+        # 短縮フラグ束（pflag は -ab のような結合を許す）
+        case "$_t" in *a*) _apr=1 ;; esac
+        case "$_t" in *c*|*r*) _other=1 ;; esac
+        continue ;;
+    esac
+    # 位置引数
+    if [ "$_st" = "0" ] && [ "$_t" = "pr" ]; then _st=1; continue; fi
+    if [ "$_st" = "1" ] && [ "$_t" = "review" ]; then _st=2; continue; fi
+  done
+  [ "$_st" = "2" ] || return 1
+  # 明示 approve → 違反 / verdict 無指定（対話モードで approve 可能）→ 安全側で違反
+  if [ "$_apr" = "1" ] || [ "$_other" = "0" ]; then return 0; fi
+  return 1
+}
+
+_scan_self_approve() {
+  _cmd=$1
+  [ -n "$_cmd" ] || return 0
+  # 正規化: タブ/CR → 空白、引用符除去、コマンド区切りを改行化
+  _norm=$(printf '%s' "$_cmd" \
+    | tr '\t\r' '  ' \
+    | sed "s/['\"\`]//g" \
+    | tr ';|&()' '\n\n\n\n\n')
+  printf '%s\n' "$_norm" | while IFS= read -r _line; do
+    [ -n "$_line" ] || continue
+    if _seg_is_self_approve "$_line"; then
+      printf 'SELF_APPROVE\t%s\n' "$_line"
+    elif _is_api_approve "$_line"; then
+      printf 'API_APPROVE\t%s\n' "$_line"
+    fi
+  done
+}
+
+_CMD=$(_json_get '.tool_input.command' 'command')
+if [ -z "$_CMD" ]; then
+  _CMD="${PLANGATE_HOOK_CMD:-}"
+fi
+if [ -n "$_CMD" ]; then
+  _hit=$(_scan_self_approve "$_CMD" | head -1)
+  if [ -n "$_hit" ]; then
+    _block "$_CMD" "AI による PR 自己承認（gh pr review --approve 相当）は禁止されています [${_hit%%	*}]"
+  fi
+fi
+
+# ===========================================================================
+# (a) 承認トークンファイルへの書き込みガード（既存）
+# ===========================================================================
+
+# PLANGATE_SKIP_TOKEN_GUARD=1 で (a) をスキップ（緊急/テスト用）
 if [ "${PLANGATE_SKIP_TOKEN_GUARD:-0}" = "1" ]; then
   exit 0
 fi
