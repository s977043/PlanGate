TRUNC-CHAR   OLD    NEW    verdict
space        rc=2   rc=2   ok
tab          rc=2   rc=2   ok
semicolon    rc=2   rc=2   ok
amp          rc=2   rc=2   ok
pipe         rc=2   rc=2   ok
lparen       rc=2   rc=2   ok
rparen       rc=2   rc=2   ok
lt           rc=2   rc=2   ok
hash         rc=2   rc=2   ok

lost: []

--- control: same chars, unquoted (not a single shell word) ---
space        rc=2   rc=0  
hash         rc=2   rc=2  

