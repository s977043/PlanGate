  task_id="${1:-}"
  if [ -z "$task_id" ]; then
    printf 'Usage: plangate brainstorm <TASK-XXXX>\n' >&2
    return 2
  fi
  shift
  exec "$plangate_root/scripts/ai-dev-workflow" "$task_id" brainstorm "$@"
}

